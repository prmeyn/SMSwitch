<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- HasNotExpired and the session DB helpers are internal, and they are exactly the logic the
         tests need to pin down. -->
    <InternalsVisibleTo Include="SMSwitch.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- This library exposes ASP.NET Core types (WebApplication, RouteGroupBuilder,
         IWebHostEnvironment), so it needs the shared framework. Previously these came in
         only as a side effect of the Microsoft.AspNetCore.OpenApi package reference, whose
         source generator does not build against Microsoft.OpenApi 3.x. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EarthCountriesInfo" Version="10.2.1" />
    <PackageReference Include="HumanLanguages" Version="11.0.1" />
    <PackageReference Include="Meyn.Utilities" Version="10.2.0" />
    <!-- The Microsoft.Extensions.* abstractions, Configuration.Binder included, ship in the
         Microsoft.AspNetCore.App shared framework referenced above. Referencing them as
         packages as well is redundant and raises NU1510. -->
    <PackageReference Include="MongoDbService" Version="10.2.1" />
    <PackageReference Include="MongoDbTokenManager" Version="10.3.1" />
    <PackageReference Include="Plivo" Version="5.52.3" />
    <PackageReference Include="SharpCompress" Version="0.50.2" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="Twilio" Version="7.14.9" />
    <PackageReference Include="uSignIn.CommonSettings" Version="10.2.0" />
  </ItemGroup>
	<ItemGroup>
		<None Include="../LICENSE" Pack="true" PackagePath="\" />
		<None Include="../README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
